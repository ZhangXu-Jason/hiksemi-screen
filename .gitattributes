# 统一以 LF 入库 —— 本项目大量 shell 脚本要在 Linux 上执行，
# 若带 CRLF 会出现 `bad interpreter: /usr/bin/env bash^M`。
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# 二进制文件不做转换
*.png  binary
*.jpg  binary
*.ico  binary
